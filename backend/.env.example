# ---------------------------------------------------------------------------
# .env.local — written for you by `npx convex dev` here (local deployment);
# the web app reads it too
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=local:<generated-name>
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# ---------------------------------------------------------------------------
# .env.prod.local — git-ignored, read by ../scripts/deploy.sh
# ---------------------------------------------------------------------------
# CONVEX_DEPLOY_KEY=prod:<production deploy key>

# ---------------------------------------------------------------------------
# Convex deployment env vars: set on EACH deployment with
# `npx convex env set` (add --prod for production), not read from a file
# ---------------------------------------------------------------------------
# JWT_PRIVATE_KEY / JWKS   npm run setup:auth (add --prod for production)
# SITE_URL=http://localhost:5173
# ALLOWED_EMAILS=you@example.com
# ENCRYPTION_KEY           openssl rand -base64 32 | npx convex env set ENCRYPTION_KEY
#                          (AES-GCM key for Jira tokens; changing it makes them unreadable)
# JIRA_CLIENT_ID / JIRA_CLIENT_SECRET   from the Atlassian OAuth 2.0 (3LO) app
# JIRA_REDIRECT_URI=http://127.0.0.1:3211/jira/callback
#                          (prod: https://<deployment>.convex.site/jira/callback)
# KUNJI_URL=http://127.0.0.1:3211   kunji's site URL (prod: https://<kunji deployment>.convex.site)
# KUNJI_SECRET=kjs_...              karya's app secret from kunji's admin Apps page
